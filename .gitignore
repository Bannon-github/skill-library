# --- environments / caches (rebuild with scripts/ensure_env.sh) ---
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
*.pyc
.pytest_cache/

# --- secrets ---
.env
.env.*
*.pem
*.key
secrets/
**/secrets/

# --- public repo: raw YouTube transcript text stays local (creators' words) ---
raw/*/raw
raw/*/raw.txt
raw/*/transcript.txt
raw/**/*.srt
raw/**/*.vtt
raw/**/*.txt
transcripts/
*.srt
*.vtt

# --- third-party vendored repos (re-fetch: scripts/refetch_prior_art.sh) ---
prior-art/vendors/
prior-art/raw/

# --- backups: git history replaces them ---
backups/

# --- audio / large outputs ---
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.ogg
*.m4a
*.mid
*.npy
*.npz
sample-lab/renders/
sample-lab/runs/**/*.png

# --- public repo: intermediate distillations embed verbatim transcript sentences ---
distilled/*/distilled.md
distilled/*/distilled.json
# third-party skill descriptions scraped from prior-art (rebuild: pipeline/build_prior_art_index.py)
prior-art/index.json

